{
  "name": "@innerhop/cli",
  "version": "0.2.0",
  "license": "MIT",
  "description": "CLI launcher and proxy runner (innerhop / ih) for InnerHop",
  "homepage": "https://github.com/EasonMWS/innerhop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/EasonMWS/innerhop.git",
    "directory": "packages/cli"
  },
  "keywords": ["ai-agent", "innerhop", "orchestrator", "cli", "claude-code", "codex", "opencode"],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "bin": {
    "innerhop": "./dist/index.js",
    "ih": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@innerhop/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
