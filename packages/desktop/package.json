{
  "name": "@innerhop/desktop",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Multi-harness dual-model InnerHop desktop app",
  "homepage": "https://github.com/EasonMWS/innerhop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/EasonMWS/innerhop.git",
    "directory": "packages/desktop"
  },
  "author": "InnerHop Contributors",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pack:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "pack:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "pack:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@innerhop/core": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
